# OpenAI API Key - REQUIRED
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Configuration - REQUIRED for db, backend, worker
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb

# Port mapping for services - OPTIONAL (defaults are set in docker-compose.yml)
BACKEND_PORT=8000
FRONTEND_PORT=3000
UPLOAD_SERVICE_PORT=8050
POSTGRES_PORT=5432 # Exposes PostgreSQL to the host machine on this port
REDIS_PORT=6379    # Exposes Redis to the host machine on this port

# Backend specific settings - OPTIONAL
# If you change SQLALCHEMY_DATABASE_URI in app/web/config/__init__.py to not use environment variables,
# you might need to set it directly here for Docker, though the compose file sets DATABASE_URL.
# SQLALCHEMY_DATABASE_URI=postgresql://${POSTGRES_USER:-user}:${POSTGRES_PASSWORD:-password}@db:5432/${POSTGRES_DB:-appdb}

# Celery specific settings - OPTIONAL
# CELERY_BROKER_URL=redis://redis:6379/0 (already set in docker-compose.yml)

# Upload service specific settings - OPTIONAL
# UPLOAD_FOLDER=/app/uploads (container path, volume mapping is in docker-compose.yml)
# FLASK_DEBUG_UPLOAD_SERVICE=0 (controls Flask debug mode for upload_service, set to 0 in compose)

# Frontend specific settings - OPTIONAL
# VITE_API_PROXY_TARGET=http://backend:8000 (used by vite.config.ts in dev, Nginx in container is pre-configured)

# Note on Database Initialization:
# After starting the services with 'docker-compose up -d', the database schema needs to be initialized.
# You can do this by running the init_db command inside the 'backend' container:
# docker-compose exec backend flask init-db
#
# Note on Uploads Directory:
# The upload_service uses a volume named 'persisted_uploads' by default to store uploaded files.
# If you changed this in docker-compose.yml to a host bind mount (e.g., ./persisted_uploads:/app/uploads),
# ensure the local directory (e.g., './persisted_uploads') exists on your host machine.
